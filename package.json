{
  "name": "ingress-gdpr-visualizer",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first interactive visualization of your own Ingress GDPR data export: UPV/UPC map, weighted heatmap, dashboard, trajectory playback and badges.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "ingest": "node scripts/ingest.mjs",
    "catalog": "node scripts/fetch-badge-catalog.mjs",
    "build:iitc": "node scripts/build-iitc.mjs",
    "check:iitc": "node scripts/build-iitc.mjs --check"
  },
  "dependencies": {
    "maplibre-gl": "^6.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
